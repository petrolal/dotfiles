# Win98 --- Windows 98 style frame for xfwm4.
# Frame pixmaps come from the "Redmond" theme (xfwm4-themes); every color
# symbol they use is pinned here, so the look does not depend on the GTK theme.

button_layout=O|HMC
button_offset=2
button_spacing=0
full_width_title=true
title_alignment=left
title_horizontal_offset=2
title_vertical_offset_active=1
title_vertical_offset_inactive=1
maximized_offset=2
show_app_icon=true
title_shadow_active=false
title_shadow_inactive=false

# Title bar: red when focused, gray when not
active_color_1=#9E2A2B
inactive_color_1=#808080
active_text_color=#ffffff
inactive_text_color=#c0c0c0

# 3D frame and buttons: classic gray face with white/gray bevels
active_color_2=#c0c0c0
inactive_color_2=#c0c0c0
active_hilight_2=#ffffff
inactive_hilight_2=#ffffff
active_shadow_2=#808080
inactive_shadow_2=#808080
active_border_color=#000000
inactive_border_color=#000000
