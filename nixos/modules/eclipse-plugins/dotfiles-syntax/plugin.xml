<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

  <!-- File-type recognition. nix/rc/glsl are new plain-text content types;
       gtkui reuses the platform's existing XML content type as its base so
       it inherits XML's own grammar via the scopeNameContentTypeBinding
       below, instead of needing its own. -->
  <extension point="org.eclipse.core.contenttype.contentTypes">
    <content-type
        id="dotfiles.syntax.nix"
        name="Nix"
        base-type="org.eclipse.core.runtime.text"
        priority="low"
        file-extensions="nix" />
    <content-type
        id="dotfiles.syntax.rc"
        name="GTK RC"
        base-type="org.eclipse.core.runtime.text"
        priority="low"
        file-extensions="rc"
        file-names="gtkrc,.gtkrc,.gtkrc-2.0" />
    <content-type
        id="dotfiles.syntax.glsl"
        name="GLSL (OpenGL/WebGL Shader)"
        base-type="org.eclipse.core.runtime.text"
        priority="low"
        file-extensions="glsl,vert,frag,geom,comp,tesc,tese" />
    <content-type
        id="dotfiles.syntax.gtkui"
        name="GTK Builder UI"
        base-type="org.eclipse.core.runtime.xml"
        priority="low"
        file-extensions="ui,glade" />
  </extension>

  <extension point="org.eclipse.tm4e.registry.grammars">
    <grammar scopeName="source.nix" path="grammars/nix.tmLanguage.json" />
    <scopeNameContentTypeBinding scopeName="source.nix" contentTypeId="dotfiles.syntax.nix" />

    <grammar scopeName="source.gtkrc" path="grammars/gtkrc.tmLanguage.json" />
    <scopeNameContentTypeBinding scopeName="source.gtkrc" contentTypeId="dotfiles.syntax.rc" />

    <grammar scopeName="source.glsl" path="grammars/glsl.tmLanguage.json" />
    <scopeNameContentTypeBinding scopeName="source.glsl" contentTypeId="dotfiles.syntax.glsl" />

    <!-- Reuse the platform XML grammar (scope text.xml, already shipped in
         org.eclipse.tm4e.language_pack) for GtkBuilder .ui/.glade files. -->
    <scopeNameContentTypeBinding scopeName="text.xml" contentTypeId="dotfiles.syntax.gtkui" />
  </extension>

  <extension point="org.eclipse.tm4e.languageconfiguration.languageConfigurations">
    <languageConfiguration contentTypeId="dotfiles.syntax.nix" path="languageConfigurations/nix.language-configuration.json" />
    <languageConfiguration contentTypeId="dotfiles.syntax.rc" path="languageConfigurations/gtkrc.language-configuration.json" />
    <languageConfiguration contentTypeId="dotfiles.syntax.glsl" path="languageConfigurations/glsl.language-configuration.json" />
  </extension>

</plugin>
