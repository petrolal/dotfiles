{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GLSL",
  "scopeName": "source.glsl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#types" },
    { "include": "#qualifiers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.glsl", "match": "//.*$" },
        { "name": "comment.block.glsl", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.glsl",
          "match": "^\\s*#\\s*(version|define|undef|if|ifdef|ifndef|else|elif|endif|include|extension|pragma|line|error)\\b.*$"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.glsl",
          "match": "\\b(void|bool|int|uint|float|double|vec2|vec3|vec4|ivec2|ivec3|ivec4|uvec2|uvec3|uvec4|bvec2|bvec3|bvec4|dvec2|dvec3|dvec4|mat2|mat3|mat4|mat2x2|mat2x3|mat2x4|mat3x2|mat3x3|mat3x4|mat4x2|mat4x3|mat4x4|sampler1D|sampler2D|sampler3D|samplerCube|sampler2DArray|samplerCubeArray|sampler2DShadow|samplerCubeShadow|image1D|image2D|image3D|imageCube|struct)\\b"
        }
      ]
    },
    "qualifiers": {
      "patterns": [
        {
          "name": "storage.modifier.glsl",
          "match": "\\b(in|out|inout|uniform|varying|attribute|const|layout|flat|smooth|noperspective|centroid|invariant|precision|highp|mediump|lowp|buffer|shared|readonly|writeonly|coherent|volatile|restrict)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.glsl",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|discard)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.glsl",
          "match": "\\b(main|texture|texture2D|texture3D|textureCube|textureLod|texelFetch|normalize|dot|cross|mix|clamp|mod|pow|sqrt|inversesqrt|length|distance|reflect|refract|floor|ceil|fract|abs|sign|min|max|step|smoothstep|radians|degrees|sin|cos|tan|asin|acos|atan|exp|log|exp2|log2|transpose|inverse|determinant)\\b(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.glsl", "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?[fF]?\\b" },
        { "name": "constant.numeric.glsl", "match": "\\b[0-9]+[uUfF]?\\b" }
      ]
    }
  }
}
