{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nix",
  "scopeName": "source.nix",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#paths" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.nix", "match": "#.*$" },
        { "name": "comment.block.nix", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nix",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.nix", "match": "\\\\." },
            { "name": "meta.embedded.nix", "match": "\\$\\{[^}]*\\}" }
          ]
        },
        {
          "name": "string.quoted.indented.nix",
          "begin": "''",
          "end": "''",
          "patterns": [
            { "name": "meta.embedded.nix", "match": "\\$\\{[^}]*\\}" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nix",
          "match": "\\b(let|in|rec|with|inherit|if|then|else|assert|or|import|builtins)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.nix", "match": "\\b(true|false|null)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.nix", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },
    "paths": {
      "patterns": [
        { "name": "string.unquoted.path.nix", "match": "\\.{0,2}/[a-zA-Z0-9_./-]+" }
      ]
    }
  }
}
