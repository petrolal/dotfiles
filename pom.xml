<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.petrolal</groupId>
  <artifactId>dotfiles-deployer</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>dotfiles-deployer</name>
  <description>Dotfiles symlink deployer and XFCE desktop settings orchestrator.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <mainClass>dev.petrolal.dotfiles.Main</mainClass>

    <junit.version>5.11.3</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${mainClass}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- `mvn -Pnative package` builds the native binary; plain `mvn package`
       only needs the JDK and stays fast for `mvn test`/day-to-day edits. -->
  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>0.10.4</version>
            <extensions>true</extensions>
            <configuration>
              <imageName>invoker</imageName>
              <!-- Keeps the binary at bin/invoker, exactly where the old
                   Makefile build and DotfilePaths.findDotfilesRoot()'s
                   src/bin-stripping heuristic both expect it. -->
              <outputDirectory>${project.basedir}/bin</outputDirectory>
              <mainClass>${mainClass}</mainClass>
              <!-- Same defaults as the old Makefile's NATIVE_IMAGE_FLAGS, minus
                   the no-fallback and install-exit-handlers flags: GraalVM 25
                   warns both are deprecated no-ops here (the plugin already
                   adds no-fallback itself, and install-exit-handlers is on by
                   default for executables). Each flag needs its own buildArg
                   element: the plugin passes each one through as a single
                   literal process argument with no shell-style word
                   splitting, so one element holding multiple space-separated
                   flags gets misparsed by native-image as one flag's value. -->
              <buildArgs>
                <buildArg>-O3</buildArg>
                <buildArg>--gc=epsilon</buildArg>
                <buildArg>-march=native</buildArg>
              </buildArgs>
            </configuration>
            <executions>
              <execution>
                <id>build-native</id>
                <goals>
                  <goal>compile-no-fork</goal>
                </goals>
                <phase>package</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
