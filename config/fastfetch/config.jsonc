{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    },
    "source": "~/.config/fastfetch/logos/current_logo.txt"
  },
  "display": {
    "separator": " \u276f "
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name} \u276f {host-name}",
      "color": {
        "user": "cyan",
        "at": "bright_black",
        "host": "magenta"
      }
    },
    {
      "type": "custom",
      "format": "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "bright_black"
    },
    {
      "type": "custom",
      "format": "[ SYSTEM ]",
      "outputColor": "green"
    },
    {
      "type": "os",
      "key": "OS        ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "key": "Flavor    ",
      "keyColor": "cyan",
      "format": "matriz (agy)"
    },
    {
      "type": "kernel",
      "key": "Kernel    ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "Uptime    ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": "[ DESKTOP ]",
      "outputColor": "green"
    },
    {
      "type": "wm",
      "key": "WM        ",
      "keyColor": "cyan",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "terminal",
      "key": "Terminal  ",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "Shell     ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "custom",
      "format": "[ HARDWARE ]",
      "outputColor": "green"
    },
    {
      "type": "cpu",
      "key": "CPU       ",
      "keyColor": "magenta",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "GPU       ",
      "keyColor": "magenta",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory    ",
      "keyColor": "magenta",
      "format": "[ {used} / {total} ] ({percentage})"
    },
    {
      "type": "disk",
      "key": "Disk      ",
      "keyColor": "magenta",
      "format": "[ {size-used} / {size-total} ] ({size-percentage}) [{filesystem}]"
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "colors",
      "symbol": "square",
      "block": {
        "range": [
          1,
          6
        ],
        "width": 3
      }
    }
  ]
}