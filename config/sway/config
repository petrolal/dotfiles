### ~/.config/sway/config
### Production Sway configuration — Ubuntu 24.04 / Arch Linux, enterprise/dev workstation.
### Style: native Sway defaults + Polyomino "matriz" palette (Gold/Teal), running
### on SwayFX for rounded corners/blur/shadows. ML4W-inspired keybindings.
###
### Reload after edits with: SUPER+SHIFT+C  (or `swaymsg reload`)

### ────────────────────────────────────────────────────────────────
### Variables
### ────────────────────────────────────────────────────────────────
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $launcher ~/.config/sway/scripts/polyomino-tilemenu.py --drun || polyomino launcher
set $lock ~/.config/sway/scripts/polyomino-rubik-lock
set $send-notify exec notify-send -a polyomino

set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9

### ────────────────────────────────────────────────────────────────
### Autostart (Wayland-first, corporate-compatible)
### ────────────────────────────────────────────────────────────────
# Wallpaper + client colors — generated by `polyomino-theme`, do not edit directly.
# Run `polyomino-theme set <flavor> [--wallpaper <path>|--flat]`; use
# `polyomino-theme list` for the flavors (matriz, encruza, caravela, aruanda).
# Default flavor: matriz.
include colors.conf

# Notification daemon (SwayNC) — Wayland-native notification center with history & control panel.
exec_always pgrep -x swaync >/dev/null || swaync

# Status bar
exec_always pgrep -x waybar >/dev/null || waybar

# ── Floating Window Rules & Standardized Geometry ──
# Dedicated Floating Terminal Profile
for_window [app_id="floating-term"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [class="floating-term"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="kitty" title="floating-term"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="Alacritty" title="floating-term"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="foot" title="floating-term"] floating enable, border pixel 2, resize set 900 550, move position center

# Standard Dialogs, Popups & Utilities
for_window [window_role="pop-up"] floating enable, resize set 900 550, move position center
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable, resize set 900 550, move position center
for_window [window_type="dialog"] floating enable, resize set 900 550, move position center
for_window [app_id="pavucontrol"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="blueman-manager"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="nm-connection-editor"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="wdisplays"] floating enable, border pixel 2, resize set 950 600, move position center
for_window [app_id="(?i).*polkit.*"] floating enable, border pixel 2, move position center
for_window [app_id="pinentry.*"] floating enable, border pixel 2, move position center
for_window [class="(?i).*polkit.*"] floating enable, border pixel 2, move position center
for_window [class="(?i).*pinentry.*"] floating enable, border pixel 2, move position center

# Floating Polyomino System Windows
# (the calendar popup is a wlr-layer-shell surface, not an xdg toplevel — for_window
# criteria never match it; its placement is set via GtkLayerShell anchors/margins in
# CalendarPopup.scala's PythonRunnerScript)
for_window [app_id="polyomino-welcome"] floating enable, border pixel 2, resize set 840 620, move position center, blur enable
for_window [app_id="polyomino-lock-preview"] floating enable, border pixel 2, resize set 1024 720, move position center

# Polyomino tile menus (theme-picker, wallpaper-picker, menu, whichkey, projects)
# — one shared GTK grid window, borderless with a glass-blur backdrop
for_window [app_id="polyomino-tilemenu"] floating enable, border none, move position center, blur enable
for_window [app_id="wofi"] floating enable, border none, move position center
for_window [app_id="rofi"] floating enable, border none, move position center
for_window [class="Rofi"] floating enable, border none, move position center
for_window [app_id="fuzzel"] border none

# Quick system-status & TUI popups (bluetooth, audio mixer, network)
for_window [app_id="kitty" title="(?i).*(wiremix|pulsemixer|ncpamixer).*"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="kitty" title="(?i).*(impala|wifui|nmtui|bluetui).*"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="kitty" title="bluetui"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="kitty" title="ncpamixer"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="bluetui"] floating enable, border pixel 2, resize set 900 550, move position center
for_window [app_id="ncpamixer"] floating enable, border pixel 2, resize set 900 550, move position center

# Dedicated Scratchpad Windows
for_window [app_id="kitty" title="(?i).*scratchpad.*"] floating enable, border pixel 2, resize set 1000 700, move position center
for_window [app_id="scratchpad-term"] floating enable, border pixel 2, resize set 1000 700, move position center
for_window [app_id="scratchpad-comms"] floating enable, border pixel 2, resize set 1000 700, move position center

# Gaming window rules (Steam dialogs, Lutris, Heroic, Gamescope)
for_window [class="^Steam$" title="^Friends List$"] floating enable
for_window [class="^Steam$" title=".* - Chat"] floating enable
for_window [class="^Steam$" title="^Settings$"] floating enable
for_window [class="^gamescope$"] fullscreen enable, floating enable
for_window [app_id="gamescope"] fullscreen enable, floating enable
for_window [class="^heroic$"] floating enable
for_window [class="^lutris$"] floating enable

for_window [app_id="mpv"] fullscreen enable

# Bento-card power / exit modal (polyomino power-menu)
for_window [app_id="polyomino-power"] floating enable, border pixel 1, resize set 860 880, move position center, blur enable, shadow enable
for_window [class="polyomino-power"] floating enable, border pixel 1, resize set 860 880, move position center, blur enable, shadow enable
for_window [app_id="polyomino-power-menu"] floating enable, border pixel 1, resize set 860 880, move position center, blur enable, shadow enable
for_window [class="polyomino-power-menu"] floating enable, border pixel 1, resize set 860 880, move position center, blur enable, shadow enable
for_window [app_id="kitty" title="(?i).*polyomino.*power-menu.*"] floating enable, border pixel 1, resize set 860 880, move position center, blur enable, shadow enable

# Puzzle Micro-Utilities (Bento Floating Modals)
for_window [app_id="(?i).*polyomino-puzzle.*"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [class="(?i).*polyomino-puzzle.*"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [app_id="polyomino-puzzle-sokoban"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [class="polyomino-puzzle-sokoban"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [app_id="polyomino-puzzle-2048"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [class="polyomino-puzzle-2048"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [app_id="polyomino-puzzle-sweeper"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [class="polyomino-puzzle-sweeper"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [app_id="polyomino-puzzle-lightsout"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [class="polyomino-puzzle-lightsout"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [app_id="polyomino-puzzle-nonogram"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable
for_window [class="polyomino-puzzle-nonogram"] floating enable, border pixel 1, resize set 860 800, move position center, blur enable, shadow enable

# System tray helper for network/VPN status
exec nm-applet --indicator

# 1Password — starts minimized to tray
exec 1password --silent

# Idle management (lock -> screen off -> suspend)
exec swayidle -w \
    timeout 600 '~/.local/bin/polyomino-rubik-lock' \
    timeout 900 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep '~/.local/bin/polyomino-rubik-lock'

# Fibonacci spiral autotiling daemon
exec_always autotiling || sh -c 'pkill -f "^$HOME/.local/bin/polyomino-autotiling"; ~/.local/bin/polyomino-autotiling'

# Set FastFetch logo 
exec_always --no-startup-id ~/.local/bin/polyomino fastfetch-logo

# Polkit authentication agent
exec sh -c 'for p in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 /usr/bin/lxpolkit; do if [ -x "$p" ]; then exec "$p"; fi; done'

# Welcome Center
exec ~/.local/bin/polyomino-welcome --autostart

### ────────────────────────────────────────────────────────────────
### Environment variables (Wayland-first app behavior)
### ────────────────────────────────────────────────────────────────
exec_always systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec_always hash dbus-update-activation-environment 2>/dev/null && \
  dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

set $XDG_CURRENT_DESKTOP sway
set $XDG_SESSION_TYPE wayland
set $MOZ_ENABLE_WAYLAND 1
set $NIXOS_OZONE_WL 1

### ────────────────────────────────────────────────────────────────
### Output (monitor) configuration
### ────────────────────────────────────────────────────────────────
output eDP-1 position 0 0
output HDMI-A-1 position 1920 0
output HDMI-* position 1920 0

### ────────────────────────────────────────────────────────────────
### Input configuration & Mouse Interactions
### ────────────────────────────────────────────────────────────────
seat * shortcuts_inhibitor disable

input type:keyboard {
    xkb_layout us
    xkb_variant intl
    repeat_delay 300
    repeat_rate 40
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# Touchpad Gestures
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next
bindgesture swipe:3:up fullscreen toggle
bindgesture swipe:3:down floating toggle

# Mouse Drag & Instantaneous Floating Detachment
floating_modifier $mod normal
bindsym --whole-window $mod+button2 floating toggle
bindsym --whole-window $mod+button3 floating toggle

### ────────────────────────────────────────────────────────────────
### Appearance — Polyomino palette & SwayFX Effects
### ────────────────────────────────────────────────────────────────
font pango:JetBrainsMono Nerd Font 10

corner_radius 8
smart_corner_radius off
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4
smart_gaps on
smart_borders no_gaps
focus_follows_mouse no
workspace_auto_back_and_forth yes

# SwayFX-specific effects (blur, shadows, dimming)
include fx.conf

### ────────────────────────────────────────────────────────────────
### Workspace -> Output assignments (Dynamic 1 or 2 Monitor Setup)
### ────────────────────────────────────────────────────────────────
# Primary Focus Workspaces: Prefer external monitor, fallback to laptop display (eDP-1)
workspace $ws2 output HDMI-A-1 DP-1 HDMI-1 HDMI-2 eDP-1
workspace $ws7 output HDMI-A-1 DP-1 HDMI-1 HDMI-2 eDP-1
workspace $ws8 output HDMI-A-1 DP-1 HDMI-1 HDMI-2 eDP-1

# Secondary / Aux / Comms / Web Workspaces: Prefer laptop display (eDP-1), fallback to external
workspace $ws1 output eDP-1 HDMI-A-1 DP-1 HDMI-1 HDMI-2
workspace $ws3 output eDP-1 HDMI-A-1 DP-1 HDMI-1 HDMI-2
workspace $ws4 output eDP-1 HDMI-A-1 DP-1 HDMI-1 HDMI-2
workspace $ws5 output eDP-1 HDMI-A-1 DP-1 HDMI-1 HDMI-2
workspace $ws6 output eDP-1 HDMI-A-1 DP-1 HDMI-1 HDMI-2
workspace $ws9 output eDP-1 HDMI-A-1 DP-1 HDMI-1 HDMI-2


### ────────────────────────────────────────────────────────────────
### Application -> workspace assignment
### ────────────────────────────────────────────────────────────────
# 1: SYS (Terminal, system monitors)
assign [app_id="btop"] $ws1
assign [class="btop"] $ws1
assign [app_id="htop"] $ws1
assign [class="htop"] $ws1
assign [app_id="kitty" title="(?i).*(btop|htop|system-monitor).*"] $ws1

# 2: DEV (Tetravim, Neovim project sessions)
assign [app_id="nvim-project"] $ws2
assign [class="nvim-project"] $ws2
assign [app_id="tetravim"] $ws2
assign [class="tetravim"] $ws2
assign [app_id="code"] $ws2
assign [class="Code"] $ws2
assign [class="jetbrains-idea"] $ws2
assign [class="jetbrains-idea-ce"] $ws2
for_window [app_id="nvim-project"] move to workspace $ws2, workspace $ws2
for_window [class="nvim-project"] move to workspace $ws2, workspace $ws2
for_window [app_id="tetravim"] move to workspace $ws2, workspace $ws2
for_window [class="tetravim"] move to workspace $ws2, workspace $ws2

# 3: WEB (Browser, API clients)
assign [app_id="firefox"] $ws3
assign [class="firefox"] $ws3
assign [app_id="google-chrome"] $ws3
assign [class="google-chrome"] $ws3
assign [app_id="google-chrome-stable"] $ws3
assign [class="Google-chrome"] $ws3
assign [app_id="microsoft-edge"] $ws3
assign [class="Microsoft-edge"] $ws3
assign [app_id="chromium"] $ws3
assign [class="Chromium"] $ws3
assign [app_id="postman"] $ws3
assign [class="Postman"] $ws3
assign [app_id="insomnia"] $ws3
assign [class="Insomnia"] $ws3
assign [app_id="bruno"] $ws3
assign [class="Bruno"] $ws3

# 4: MEDIA (Media players, gaming, idle screensavers)
assign [app_id="spotify"] $ws4
assign [class="[sS]potify.*"] $ws4
assign [app_id="spotify_player"] $ws4
assign [app_id="kitty" title="spotify"] $ws4
assign [app_id="kitty" title="^spotify$"] $ws4
for_window [app_id="spotify_player"] move to workspace $ws4
for_window [app_id="kitty" title="^spotify$"] move to workspace $ws4
assign [app_id="mpv"] $ws4
assign [class="mpv"] $ws4
assign [app_id="vlc"] $ws4
assign [class="vlc"] $ws4
assign [app_id="(?i)^steam$"] $ws4
assign [class="(?i)steam.*"] $ws4
assign [instance="(?i)steam.*"] $ws4
assign [class="(?i)steamwebhelper"] $ws4
assign [instance="(?i)steamwebhelper"] $ws4
assign [class="^steam_app_.*"] $ws4
assign [class="^heroic$"] $ws4
assign [class="^lutris$"] $ws4
assign [app_id="gamescope"] $ws4
assign [class="^gamescope$"] $ws4
for_window [class="(?i)steam.*"] move container to workspace number 4, workspace number 4
for_window [instance="(?i)steam.*"] move container to workspace number 4, workspace number 4
for_window [class="(?i)steamwebhelper"] move container to workspace number 4, workspace number 4
for_window [instance="(?i)steamwebhelper"] move container to workspace number 4, workspace number 4
for_window [app_id="(?i)steam"] move container to workspace number 4, workspace number 4
for_window [class="^steam_app_.*"] move container to workspace number 4, workspace number 4
for_window [class="^heroic$"] move container to workspace number 4, workspace number 4
for_window [class="^lutris$"] move container to workspace number 4, workspace number 4
for_window [class="^gamescope$"] move container to workspace number 4, workspace number 4
for_window [app_id="gamescope"] move container to workspace number 4, workspace number 4

# Emulators (polyomino install-emulator suite + common third-party emulators)
for_window [app_id="(?i)^(mesen|bsnes|sameboy|mgba-qt|mgba|mame|flycast|blastem|duckstation|simple64|retroarch|dolphin-emu|citra-qt|yuzu|ryujinx|cemu|ppsspp|pcsx2-qt|pcsx2|rpcs3)$"] move container to workspace number 4, workspace number 4
for_window [class="(?i)^(mesen|bsnes|sameboy|mgba-qt|mgba|mame|flycast|blastem|duckstation|simple64|retroarch|dolphin-emu|citra-qt|yuzu|ryujinx|cemu|ppsspp|pcsx2-qt|pcsx2|rpcs3)$"] move container to workspace number 4, workspace number 4
assign [app_id="(?i)^(mesen|bsnes|sameboy|mgba-qt|mgba|mame|flycast|blastem|duckstation|simple64|retroarch|dolphin-emu|citra-qt|yuzu|ryujinx|cemu|ppsspp|pcsx2-qt|pcsx2|rpcs3)$"] $ws4
assign [class="(?i)^(mesen|bsnes|sameboy|mgba-qt|mgba|mame|flycast|blastem|duckstation|simple64|retroarch|dolphin-emu|citra-qt|yuzu|ryujinx|cemu|ppsspp|pcsx2-qt|pcsx2|rpcs3)$"] $ws4

# 5: COMMS
assign [app_id="kitty" title="aerc"] $ws5
assign [app_id="thunderbird"] $ws5
assign [class="Thunderbird"] $ws5
assign [app_id="telegramdesktop"] $ws5
assign [class="TelegramDesktop"] $ws5
assign [app_id="discord"] $ws5
assign [class="discord"] $ws5
assign [app_id="Slack"] $ws5
assign [class="Slack"] $ws5

# 6: NOTES
assign [app_id="obsidian"] $ws6
assign [class="obsidian"] $ws6

# 7: INFRA
assign [app_id="kitty" title="infra"] $ws7
assign [app_id="docker-desktop"] $ws7
assign [class="Docker Desktop"] $ws7
assign [app_id="lens"] $ws7
assign [class="Lens"] $ws7

# Auto-tabbed layouts for multi-window communication & web workspaces
for_window [workspace="^5$"] layout tabbed
for_window [workspace="^3$"] layout tabbed

### ────────────────────────────────────────────────────────────────
### Key bindings
### ────────────────────────────────────────────────────────────────

# Basics, Terminal & Floating Terminal (Interactive Drag Window)
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec ~/.local/bin/polyomino draw-window --spawn
bindsym $mod+Shift+q kill
bindsym $mod+d exec $launcher
bindsym $mod+Shift+b exec google-chrome-stable, workspace $ws3
bindsym $mod+Shift+f exec $term -e yazi
bindsym $mod+Shift+m exec $term --app-id spotify_player --title spotify -e spotify_player, workspace $ws4
bindsym $mod+Shift+o exec obsidian, workspace $ws6
bindsym $mod+Shift+u exec $term --title bluetui -e bluetui
bindsym $mod+Shift+v exec $term --title pulsemixer -e sh -c 'wiremix || pulsemixer || ncpamixer'
bindsym $mod+Shift+i exec $term --title nmtui -e sh -c 'impala || wifui || nmtui'
bindsym $mod+Shift+n exec swaync-client -t -sw # Toggle Notification Center
bindsym $mod+n exec swaync-client --close-latest # Dismiss latest notification popup
bindsym $mod+Control+n exec swaync-client --close-all # Dismiss all notification popups
bindsym $mod+Mod1+n exec swaync-client -d -sw # Toggle Do Not Disturb
bindsym $mod+Shift+g exec ~/.local/bin/polyomino-gamemode toggle # Toggle Gaming Performance Mode
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Moving around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces — Switch
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Workspaces — Move Container (Stay on current workspace)
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Workspaces — Move Container AND Follow
bindsym $mod+Control+1 move container to workspace number 1; workspace number 1
bindsym $mod+Control+2 move container to workspace number 2; workspace number 2
bindsym $mod+Control+3 move container to workspace number 3; workspace number 3
bindsym $mod+Control+4 move container to workspace number 4; workspace number 4
bindsym $mod+Control+5 move container to workspace number 5; workspace number 5
bindsym $mod+Control+6 move container to workspace number 6; workspace number 6
bindsym $mod+Control+7 move container to workspace number 7; workspace number 7
bindsym $mod+Control+8 move container to workspace number 8; workspace number 8
bindsym $mod+Control+9 move container to workspace number 9; workspace number 9
bindsym $mod+Control+0 move container to workspace number 10; workspace number 10

# Workspaces — Fast Navigation & Urgent Jump
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+bracketleft workspace prev
bindsym $mod+bracketright workspace next
bindsym $mod+u [urgent=latest] focus

# Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Draw interactive floating window with slurp (current window reshape)
bindsym $mod+Shift+w exec ~/.local/bin/polyomino draw-window --current

# Scratchpads (Generic & Dedicated Shortcuts)
bindsym $mod+Shift+minus move scratchpad, $send-notify 'Scratchpad'
bindsym $mod+minus scratchpad show
bindsym $mod+grave exec ~/.config/sway/scripts/polyomino-scratchpad term
bindsym $mod+apostrophe exec ~/.config/sway/scripts/polyomino-scratchpad aerc

# Resizing
bindsym $mod+r mode "resize"

# Cheatsheet & Pickers
bindsym $mod+p exec ~/.local/bin/polyomino projects
bindsym $mod+m exec ~/.local/bin/polyomino-menu
bindsym $mod+slash exec ~/.local/bin/polyomino-whichkey
bindsym $mod+question exec ~/.local/bin/polyomino-whichkey
bindsym $mod+Shift+d exec wdisplays
bindsym $mod+Shift+t exec ~/.local/bin/polyomino-theme-picker
bindsym $mod+F5 exec ~/.local/bin/polyomino theme next
bindsym $mod+Shift+p exec ~/.local/bin/polyomino-wallpaper
bindsym $mod+F6 exec ~/.local/bin/polyomino wallpaper next

# Lock screen & Power menu
bindsym $mod+Escape exec ~/.local/bin/polyomino-rubik-lock
bindsym $mod+Control+Escape exec $term --class=polyomino-power --app-id=polyomino-power -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino power-menu

# Puzzle Micro-Utilities (Sokoban, 2048, Sweeper, LightsOut, Nonogram)
bindsym $mod+Mod1+s exec $term --class=polyomino-puzzle-sokoban --app-id=polyomino-puzzle-sokoban -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino-sokoban
bindsym $mod+Mod1+m exec $term --class=polyomino-puzzle-2048 --app-id=polyomino-puzzle-2048 -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino-2048
bindsym $mod+Mod1+c exec $term --class=polyomino-puzzle-sweeper --app-id=polyomino-puzzle-sweeper -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino-sweeper
bindsym $mod+Mod1+l exec $term --class=polyomino-puzzle-lightsout --app-id=polyomino-puzzle-lightsout -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino-lightsout
bindsym $mod+Mod1+p exec $term --class=polyomino-puzzle-nonogram --app-id=polyomino-puzzle-nonogram -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino-nonogram

# Screenshots
bindsym Print exec ~/.local/bin/polyomino screenshot full
bindsym --release Print exec ~/.local/bin/polyomino screenshot full
bindcode 107 exec ~/.local/bin/polyomino screenshot full
bindsym $mod+Print exec ~/.local/bin/polyomino screenshot region
bindsym $mod+Shift+Print exec ~/.local/bin/polyomino screenshot window

# Audio, Media & Hardware Keys
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay        exec playerctl play-pause
bindsym --locked XF86AudioNext        exec playerctl next
bindsym --locked XF86AudioPrev        exec playerctl previous
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

### ────────────────────────────────────────────────────────────────
### Modes
### ────────────────────────────────────────────────────────────────
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

### ────────────────────────────────────────────────────────────────
### Bar (disabled — Waybar replaces the built-in swaybar)
### ────────────────────────────────────────────────────────────────
bar {
    mode invisible
}
