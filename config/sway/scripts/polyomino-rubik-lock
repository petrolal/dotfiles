# ---------------------------------------------------------------------------
# Ambient Idle Screensaver Tuning
# ---------------------------------------------------------------------------
IDLE_TIMEOUT_SECONDS = 3.0        # no keypress/motion for this long -> ambient mode
AMBIENT_YAW_SPEED = 0.18          # rad/s continuous isometric yaw drift
AMBIENT_PITCH_AMPLITUDE = 0.18    # rad, gentle pitch sway around the base angle
AMBIENT_PITCH_SPEED = 0.35
AMBIENT_BREATH_AMPLITUDE = 0.15   # scale(0.85) .. scale(1.15) "breathing"
AMBIENT_BREATH_SPEED = 0.6
AMBIENT_SHUFFLE_MIN = 1.5         # seconds between ambient slice shuffles
AMBIENT_SHUFFLE_MAX = 2.0
AMBIENT_BURST_CHANCE = 0.3        # odds a shuffle beat is a rapid multi-turn "fast hit" burst
AMBIENT_BURST_MIN_TURNS = 3
AMBIENT_BURST_MAX_TURNS = 4
AMBIENT_BURST_TURN_DURATION = 0.16  # each burst turn snaps much quicker than a normal shuffle
WAKE_DURATION = 0.25              # ease-out snap back to canonical camera

# ---------------------------------------------------------------------------
# 3D Math & Cubic-Bezier Easing
# ---------------------------------------------------------------------------
def mat_mul_vec(m, v):
    return (
        m[0][0]*v[0] + m[0][1]*v[1] + m[0][2]*v[2],
        m[1][0]*v[0] + m[1][1]*v[1] + m[1][2]*v[2],
        m[2][0]*v[0] + m[2][1]*v[1] + m[2][2]*v[2]
    )

def mat_mul_mat(a, b):
    res = [[0.0]*3 for _ in range(3)]
    for i in range(3):
        for j in range(3):
            res[i][j] = a[i][0]*b[0][j] + a[i][1]*b[1][j] + a[i][2]*b[2][j]
    return res

def rot_matrix(axis, angle):
    c = math.cos(angle)
    s = math.sin(angle)
    ax, ay, az = axis
    return [
        [c + ax*ax*(1-c),    ax*ay*(1-c) - az*s, ax*az*(1-c) + ay*s],
        [ay*ax*(1-c) + az*s, c + ay*ay*(1-c),    ay*az*(1-c) - ax*s],
        [az*ax*(1-c) - ay*s, az*ay*(1-c) + ax*s, c + az*az*(1-c)]
    ]

def cubic_bezier_ease(t):
    """Cubic-bezier easing (0.25, 0.1, 0.25, 1.0) for snappy 100ms slice rotations."""
    t = max(0.0, min(1.0, t))
    s = t
    for _ in range(5):
        x = 0.75 * (1 - s) * s + s * s * s
        dx = 0.75 * (1 - s) * (1 - s) + 2.25 * s * s
        if abs(dx) < 1e-6:
            break
        s -= (x - t) / dx
        s = max(0.0, min(1.0, s))
    return 3 * (1 - s) * (1 - s) * s * 0.1 + 3 * (1 - s) * s * s * 1.0 + s * s * s

