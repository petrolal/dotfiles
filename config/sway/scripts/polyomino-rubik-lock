# Cubie Geometry & Lattice Definitions
# ---------------------------------------------------------------------------
CUBIE_HALF_SIZE = 0.47
LOCAL_VERTS = [
    (-CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE), # 0
    (+CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE), # 1
    (+CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE), # 2
    (-CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE), # 3
    (-CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE), # 4
    (+CUBIE_HALF_SIZE, -CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE), # 5
    (+CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE), # 6
    (-CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE, +CUBIE_HALF_SIZE), # 7
]

LOCAL_EDGES = [
    (0, 1), (1, 2), (2, 3), (3, 0), # Back ring
    (4, 5), (5, 6), (6, 7), (7, 4), # Front ring
    (0, 4), (1, 5), (2, 6), (3, 7), # Connecting struts
]

LOCAL_FACES = [
    ((4, 5, 6, 7), (0, 0, 1)),   # Front (+Z)
    ((1, 0, 3, 2), (0, 0, -1)),  # Back (-Z)
    ((3, 2, 6, 7), (0, 1, 0)),   # Up (+Y)
    ((0, 1, 5, 4), (0, -1, 0)),  # Down (-Y)
    ((1, 5, 6, 2), (1, 0, 0)),   # Right (+X)
    ((0, 4, 7, 3), (-1, 0, 0)),  # Left (-X)
]

def _clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))

def _mix(c1, c2, t):
    return (
        _clamp(c1[0] + (c2[0] - c1[0]) * t),
        _clamp(c1[1] + (c2[1] - c1[1]) * t),
        _clamp(c1[2] + (c2[2] - c1[2]) * t)
    )

