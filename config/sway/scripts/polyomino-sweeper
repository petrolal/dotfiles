#!/usr/bin/env python3
"""
polyomino-sweeper — System Cache & Orphan Package Sweeper (Minesweeper Puzzle)
Part of Polyomino Dotfiles Suite.
"""

import sys
import os
import random
import subprocess
import termios
import tty
import shutil
import re

ESC = "\033["
RESET = f"{ESC}0m"
BOLD = f"{ESC}1m"
DIM = f"{ESC}2m"

BG_DARK = f"{ESC}48;2;15;17;26m"
BORDER_VIOLET = f"{ESC}38;2;139;92;246m"
CYAN = f"{ESC}38;2;6;182;212m"
AMBER = f"{ESC}38;2;245;158;11m"
VIOLET = f"{ESC}38;2;168;85;247m"
GREEN = f"{ESC}38;2;34;197;94m"
RED = f"{ESC}38;2;239;68;68m"
TEXT_WHITE = f"{ESC}38;2;248;250;252m"
TEXT_DIM = f"{ESC}38;2;100;116;139m"

ANSI_RE = re.compile(r'\x1b\[[0-9;]*[a-zA-Z]')

def strip_ansi(s):
    return ANSI_RE.sub('', s)

def visible_len(s):
    return len(strip_ansi(s))

def get_term_size():
    size = shutil.get_terminal_size(fallback=(80, 36))
    return max(80, size.columns), max(30, size.lines)

NUM_COLORS = {
    0: TEXT_DIM,
    1: f"{ESC}38;2;56;189;248m",
    2: f"{ESC}38;2;34;197;94m",
    3: f"{ESC}38;2;245;158;11m",
    4: f"{ESC}38;2;168;85;247m",
    5: f"{ESC}38;2;239;68;68m",
    6: f"{ESC}38;2;236;72;153m",
    7: f"{ESC}38;2;20;184;166m",
    8: f"{ESC}38;2;248;250;252m"
}

def build_cache_targets():
    targets = [
        ("Thumbnails", os.path.expanduser("~/.cache/thumbnails"), "rm -rf ~/.cache/thumbnails/*"),
        ("Pip Cache", os.path.expanduser("~/.cache/pip"), "rm -rf ~/.cache/pip/*"),
        ("Cargo Cache", os.path.expanduser("~/.cache/cargo"), "cargo cache --autoclean 2>/dev/null || true"),
        ("Mozilla Cache", os.path.expanduser("~/.cache/mozilla"), "rm -rf ~/.cache/mozilla/firefox/*.default*/*cache*"),
        ("Systemd User Logs", os.path.expanduser("~/.local/share/systemd"), "journalctl --user --vacuum-size=20M"),
    ]
    if os.path.exists(os.path.expanduser("~/.cache/yay")):
        targets.append(("Yay/AUR Build Cache", os.path.expanduser("~/.cache/yay"), "rm -rf ~/.cache/yay/*"))
    if os.path.exists("/var/cache/pacman/pkg"):
        targets.append(("Pacman Cache", "/var/cache/pacman/pkg", "paccache -rk1 2>/dev/null || true"))
    if os.path.exists("/var/cache/apt/archives"):
        targets.append(("APT Cache", "/var/cache/apt/archives", "sudo apt-get clean 2>/dev/null || rm -rf ~/.cache/apt/archives/* 2>/dev/null || true"))
    if os.path.exists("/var/cache/dnf"):
        targets.append(("DNF Cache", "/var/cache/dnf", "sudo dnf clean all 2>/dev/null || true"))
    targets.append(("Trash Bin", os.path.expanduser("~/.local/share/Trash"), "rm -rf ~/.local/share/Trash/*"))
    return targets

CACHE_TARGETS = build_cache_targets()

PROTECTED_PATHS = [
    "/etc",
    os.path.expanduser("~/.config"),
    "/usr/bin",
    "/boot"
]

def get_dir_size_mb(path):
    if not os.path.exists(path):
        return 0
    try:
        total = 0
        for entry in os.scandir(path):
            if entry.is_file(follow_symlinks=False):
                total += entry.stat().st_size
            elif entry.is_dir(follow_symlinks=False):
                total += get_dir_size_mb(entry.path) * 1024 * 1024
        return total // (1024 * 1024)
    except Exception:
        return 0

def get_disk_usage():
    try:
        stat = shutil.disk_usage(os.path.expanduser("~"))
        return {
            "total": stat.total // (1024 * 1024 * 1024),
            "used": stat.used // (1024 * 1024 * 1024),
            "free": stat.free // (1024 * 1024 * 1024),
            "pct": int(stat.used / stat.total * 100)
        }
    except Exception:
        return {"total": 512, "used": 240, "free": 272, "pct": 47}

class SweeperGame:
    def __init__(self, rows=8, cols=8):
        self.rows = rows
        self.cols = cols
        self.cursor_r = 0
        self.cursor_c = 0
        self.uncovered = [[False]*cols for _ in range(rows)]
        self.flagged = [[False]*cols for _ in range(rows)]
        self.mines = [[False]*cols for _ in range(rows)]
        self.targets = [[None]*cols for _ in range(rows)]
        self.sizes = [[0]*cols for _ in range(rows)]
        self.counts = [[0]*cols for _ in range(rows)]
        self.status_msg = "Audit system caches. Flag cells to mark for purge."
        self.status_color = CYAN
        self.disk = get_disk_usage()
        self.reclaimed_mb = 0
        self.purged_count = 0
        self.init_grid()

    def init_grid(self):
        # Assign real cache targets to random cells
        num_targets = min(12, self.rows * self.cols // 4)
        target_indices = random.sample(range(self.rows * self.cols), num_targets)
        for i, idx in enumerate(target_indices):
            r = idx // self.cols
            c = idx % self.cols
            target = CACHE_TARGETS[i % len(CACHE_TARGETS)]
            size = get_dir_size_mb(target[1])
            self.targets[r][c] = target
            self.sizes[r][c] = size if size > 0 else (random.randint(10, 250))
            self.mines[r][c] = True

        # Calculate neighbor counts
        for r in range(self.rows):
            for c in range(self.cols):
                if not self.mines[r][c]:
                    cnt = 0
                    for dr in (-1, 0, 1):
                        for dc in (-1, 0, 1):
                            nr, nc = r + dr, c + dc
                            if 0 <= nr < self.rows and 0 <= nc < self.cols and self.mines[nr][nc]:
                                cnt += 1
                    self.counts[r][c] = cnt

    def move(self, dr, dc):
        self.cursor_r = max(0, min(self.rows - 1, self.cursor_r + dr))
        self.cursor_c = max(0, min(self.cols - 1, self.cursor_c + dc))

    def reveal(self):
        r, c = self.cursor_r, self.cursor_c
        if self.flagged[r][c] or self.uncovered[r][c]:
            return
        self.uncovered[r][c] = True
        print("\a", end="", flush=True)

        if self.mines[r][c]:
            tgt = self.targets[r][c]
            mb = self.sizes[r][c]
            self.status_msg = f"[CACHE HIT] Found {tgt[0]} ({mb} MB). Press 'f' to flag for purge."
            self.status_color = AMBER
        else:
            if self.counts[r][c] == 0:
                self.reveal_flood(r, c)
            self.status_msg = f"Sector inspected. Clean area ({self.counts[r][c]} cache nodes nearby)."
            self.status_color = CYAN

    def reveal_flood(self, r, c):
        for dr in (-1, 0, 1):
            for dc in (-1, 0, 1):
                nr, nc = r + dr, c + dc
                if 0 <= nr < self.rows and 0 <= nc < self.cols and not self.uncovered[nr][nc] and not self.flagged[nr][nc]:
                    self.uncovered[nr][nc] = True
                    if self.counts[nr][nc] == 0 and not self.mines[nr][nc]:
                        self.reveal_flood(nr, nc)

    def toggle_flag(self):
        r, c = self.cursor_r, self.cursor_c
        if not self.uncovered[r][c]:
            self.flagged[r][c] = not self.flagged[r][c]
            print("\a", end="", flush=True)
            if self.flagged[r][c]:
                self.status_msg = f"[FLAGGED] Sector ({r+1}, {c+1}) scheduled for safe cache purge."
                self.status_color = VIOLET
            else:
                self.status_msg = f"[UNFLAGGED] Sector ({r+1}, {c+1}) removed from purge queue."
                self.status_color = CYAN

    def clean_flagged(self):
        purged = 0
        mb_freed = 0
        for r in range(self.rows):
            for c in range(self.cols):
                if self.flagged[r][c] and self.targets[r][c]:
                    name, path, purge_cmd = self.targets[r][c]
                    if not any(path.startswith(p) for p in PROTECTED_PATHS):
                        try:
                            subprocess.run(purge_cmd, shell=True, timeout=2, capture_output=True)
                            mb_freed += self.sizes[r][c]
                            purged += 1
                        except Exception:
                            pass
        self.reclaimed_mb += mb_freed
        self.purged_count += purged
        self.disk = get_disk_usage()
        self.status_msg = f"[PURGE COMPLETED] Reclaimed ~{mb_freed} MB across {purged} cache directories."
        self.status_color = GREEN
        print("\a", end="", flush=True)

    def render(self, term_w=80, term_h=36):
        card_w = min(term_w - 2, 76)
        card_h = min(term_h - 2, 34)
        left = max(0, (term_w - card_w) // 2)
        top = max(0, (term_h - card_h) // 2)
        right = left + card_w - 1
        bottom = top + card_h - 1

        buf = []
        buf.append(f"{ESC}?25l{ESC}2J{ESC}H{BG_DARK}")

        # Bento Card
        span = "─" * (card_w - 2)
        buf.append(f"{ESC}{top+1};{left+1}H{BORDER_VIOLET}┌{span}┐")
        for y in range(top + 2, bottom + 1):
            buf.append(f"{ESC}{y};{left+1}H{BORDER_VIOLET}│{ESC}{y};{right+1}H{BORDER_VIOLET}│")
        buf.append(f"{ESC}{top+3};{left+1}H{BORDER_VIOLET}├{span}┤")
        buf.append(f"{ESC}{bottom-2};{left+1}H{BORDER_VIOLET}├{span}┤")
        buf.append(f"{ESC}{bottom+1};{left+1}H{BORDER_VIOLET}└{span}┘")

        # Header
        header_title = f"{BORDER_VIOLET}[ ⮽ ] {CYAN}[ SWEEPER // DISK CACHE AUDIT & CLEANER ]"
        stat_tag = f"{AMBER}[ PURGED: {self.reclaimed_mb} MB ]"
        buf.append(f"{ESC}{top+2};{left+3}H{header_title}")
        tag_x = max(left + 3, right - visible_len(stat_tag) - 1)
        buf.append(f"{ESC}{top+2};{tag_x}H{stat_tag}")

        # Left Panel: Storage Telemetry & Flagged Queue
        tl_left = left + 4
        tl_top = top + 5
        buf.append(f"{ESC}{tl_top};{tl_left}H{VIOLET}{BOLD}[ DISK TELEMETRY ]{RESET}{BG_DARK}")
        buf.append(f"{ESC}{tl_top+2};{tl_left}H{TEXT_DIM}DISK USAGE:  {TEXT_WHITE}{self.disk['used']} / {self.disk['total']} GB ({self.disk['pct']}%)")

        bar_len = 20
        used_bars = int(bar_len * (self.disk['pct'] / 100.0))
        d_bar = f"{RED}{'█'*used_bars}{TEXT_DIM}{'░'*(bar_len-used_bars)}{RESET}{BG_DARK}"
        buf.append(f"{ESC}{tl_top+3};{tl_left}H[{d_bar}]")

        flagged_count = sum(self.flagged[r][c] for r in range(self.rows) for c in range(self.cols))
        buf.append(f"{ESC}{tl_top+5};{tl_left}H{TEXT_DIM}FLAGGED:     {AMBER}{flagged_count} sectors queued")
        buf.append(f"{ESC}{tl_top+6};{tl_left}H{TEXT_DIM}RECLAIMED:   {GREEN}{self.reclaimed_mb} MB total")

        buf.append(f"{ESC}{tl_top+8};{tl_left}H{VIOLET}{BOLD}[ AUDIT LEGEND ]{RESET}{BG_DARK}")
        buf.append(f"{ESC}{tl_top+9};{tl_left}H{TEXT_DIM}■ Hidden   {VIOLET}⚑ Flagged")
        buf.append(f"{ESC}{tl_top+10};{tl_left}H{AMBER}✦ Cache    {TEXT_DIM}· Clean")

        # Right Panel: Minesweeper Grid
        grid_left = left + 32
        grid_top = top + 5

        for r in range(self.rows):
            line_cells = []
            for c in range(self.cols):
                is_cur = (r == self.cursor_r and c == self.cursor_c)
                cur_open = f"{CYAN}[" if is_cur else " "
                cur_close = f"{CYAN}]" if is_cur else " "

                if self.flagged[r][c]:
                    cell = f"{VIOLET}{BOLD}⚑{RESET}{BG_DARK}"
                elif not self.uncovered[r][c]:
                    cell = f"{TEXT_DIM}■{RESET}{BG_DARK}"
                elif self.mines[r][c]:
                    cell = f"{AMBER}{BOLD}✦{RESET}{BG_DARK}"
                else:
                    cnt = self.counts[r][c]
                    col = NUM_COLORS.get(cnt, TEXT_WHITE)
                    cell = f"{col}{cnt if cnt > 0 else '·'}{RESET}{BG_DARK}"

                line_cells.append(f"{cur_open}{cell}{cur_close}")

            buf.append(f"{ESC}{grid_top + r * 2};{grid_left}H" + "".join(line_cells))

        # Status Line
        max_status_len = card_w - 6
        buf.append(f"{ESC}{bottom-3};{left+3}H{self.status_color}{self.status_msg[:max_status_len]:<{max_status_len}}{RESET}{BG_DARK}")

        # Footer
        footer_badge = f"{CYAN}[ NORMAL ]{RESET}{BG_DARK}"
        footer_keys = f"{TEXT_DIM}h/j/k/l Move • Space Reveal • f Flag • c Purge • q/Esc Exit{RESET}{BG_DARK}"
        buf.append(f"{ESC}{bottom-1};{left+3}H{footer_badge}  {footer_keys}")

        buf.append(f"{ESC}{term_h};1H{RESET}")
        sys.stdout.write("".join(buf))
        sys.stdout.flush()

def main():
    is_tty = sys.stdin.isatty()
    old_settings = termios.tcgetattr(sys.stdin) if is_tty else None
    try:
        if is_tty:
            tty.setraw(sys.stdin.fileno())
        sys.stdout.write(f"{ESC}?1049h{ESC}?25l{ESC}2J")
        sys.stdout.flush()
        game = SweeperGame()
        while True:
            w, h = get_term_size()
            game.render(w, h)

            ch = sys.stdin.read(1)
            if not ch or ch in ('q', 'Q', '\x1b'):
                break
            elif ch in ('h', 'a'): game.move(0, -1)
            elif ch in ('l', 'd'): game.move(0, 1)
            elif ch in ('k', 'w'): game.move(-1, 0)
            elif ch in ('j', 's'): game.move(1, 0)
            elif ch == ' ': game.reveal()
            elif ch in ('f', 'F'): game.toggle_flag()
            elif ch in ('c', 'C', '\r', '\n'): game.clean_flagged()
            elif ch in ('r', 'R'):
                game = SweeperGame()
    finally:
        if is_tty and old_settings:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
        sys.stdout.write(f"{ESC}?25h{ESC}?1049l{RESET}")
        sys.stdout.flush()

if __name__ == "__main__":
    main()
