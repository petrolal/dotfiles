# Astroland-matching theme: black CRT background, white bold/italic
# monospace nerd-font text (same look as the quickshell overlays in
# config/quickshell/InfoOverlayComponent.qml and NotifsOverlay.qml).

font = BigBlueTermPlus Nerd Font
font-size = 24

background-color = #000000ee
text-color = #ffffff
prompt-color = #ffffff
placeholder-color = #999999
input-color = #ffffff
default-result-color = #ffffff
alternate-result-color = #ffffff
selection-color = #000000
selection-background = #ffffff
selection-match-color = #ffffff
border-color = #999999

width = 40%
height = 40%
anchor = center
border-width = 2
outline-width = 0
corner-radius = 0
padding-top = 24
padding-bottom = 24
padding-left = 24
padding-right = 24

prompt-text = "> "
placeholder-text = "run:"
result-spacing = 8
num-results = 8

horizontal = false
hide-cursor = false
