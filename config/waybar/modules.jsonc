{
  // trailing brand pill — click opens the polyomino launcher (power / theme / config),
  // right-click jumps straight to the Tetris power menu. Each bar object in
  // config.jsonc overrides on-click with `--output <name>` so the wofi menu
  // opens on the monitor whose pill was clicked; this bare handler is the
  // fallback for any bar without an override (menu lands on the focused output).
  "custom/polyomino": {
    "format": "⊞",
    "tooltip": false,
    "on-click": "~/.local/bin/polyomino menu",
    "on-click-right": "kitty --class=polyomino-power -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino power-menu",
  },
  // waybar-battery
  "battery": {
    "interval": 30,
    "align": 0,
    "rotate": 0,
    "full-at": 100,
    "design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
    "format-time": "{H}h {M}min",
  },
  // waybar-cpu
  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "tooltip": true,
  },
  // waybar-memory
  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB",
  },

  // waybar-bluetooth
  "bluetooth": {
    "format": "󰂯 {status}",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲",
    "tooltip-format": "{controller_alias}: {status}",
    "tooltip": true,
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "kitty --class=bluetui -T bluetui -e bluetui",
  },
  // waybar-clock — compact HH:MM, full date/time in tooltip
  "clock": {
    "interval": 1,
    "align": 0,
    "rotate": 0,
    "tooltip": true,
    "format": " {:%H:%M}",
    "tooltip-format": "{:%H:%M:%S  ·  %A %d %B %Y}",
    "on-click": "~/.local/bin/polyomino calendar",
  },
  // CAD dot matrix separator
  "custom/matriz": {
    "format": "·",
    "tooltip": false,
  },
  // waybar-idle-inhibitor
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
    "timeout": 30,
  },
  // waybar-media — any MPRIS player (Spotify, browser, mpv, ...)
  "custom/media": {
    "exec": "~/.local/bin/polyomino media-status",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "max-length": 40,
    "on-click": "playerctl -p spotify_player,spotify,%any play-pause",
    "on-click-middle": "playerctl -p spotify_player,spotify,%any previous",
    "on-click-right": "playerctl -p spotify_player,spotify,%any next",
    "on-scroll-up": "playerctl -p spotify_player,spotify,%any volume 0.05+",
    "on-scroll-down": "playerctl -p spotify_player,spotify,%any volume 0.05-",
    "smooth-scrolling-threshold": 1,
  },
  // waybar-mpd
  "mpd": {
    "interval": 2,
    "unknown-tag": "N/A",
    "format": "{artist} - {title} {stateIcon}",
    "format-disconnected": " Disconnected",
    "format-paused": "{artist} - {title} {stateIcon}",
    "format-stopped": "Stopped ",
    "state-icons": {
      "paused": "",
      "playing": "",
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)",
    "on-click": "mpc toggle",
    "on-click-middle": "kitty --class=floating-term -T ncmpcpp -e ncmpcpp",
    "on-click-right": "mpc next",
    "on-update": "",
    "on-scroll-up": "mpc seek +5%",
    "on-scroll-down": "mpc seek -5%",
    "smooth-scrolling-threshold": 1,
  },
  // waybar-network — icon only, IP lives in the tooltip
  "network": {
    "interval": 5,
    "format-wifi": "󰩠",
    "format-ethernet": "󰩠",
    "format-linked": "󰩠",
    "format-disconnected": "",
    "format-disabled": "󰈂",
    "tooltip-format-wifi": "{essid}  {ifname}: {ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty --class=nmtui -T nmtui -e sh -c 'impala || wifui || nmtui'",
    "on-click-right": "nm-connection-editor",
  },
  // waybar-pulseaudio
  "pulseaudio": {
    //"format": "{volume}% {icon} {format_source}",
    "format": "{icon} {volume}%",
    "format-muted": " Mute",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰗿 Mute",
    "format-source": " {volume}%",
    "format-source-muted": " Mute",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "scroll-step": 5.0,
    "on-click": "kitty --class=ncpamixer -T ncpamixer -e ncpamixer",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "smooth-scrolling-threshold": 1,
  },
  // waybar-sway-mode
  "sway/mode": {
    "format": "MODE: {}",
    "tooltip": false,
  },
  // waybar-sway-window
  "sway/window": {
    "format": "{}",
    "max-length": 40,
    "icon": false,
  },
  // waybar-sway-workspaces
  "sway/workspaces": {
    "disable-scroll": true,
    "disable-click": false,
    "all-outputs": false,
    "format": "{name} <span size='small'>{icon}</span>",
    "persistent_workspaces": {
      "1": ["eDP-1"],
      "2": ["HDMI-A-1"],
      "3": ["eDP-1"],
      "4": ["eDP-1"],
      "5": ["eDP-1"],
      "6": ["eDP-1"],
      "7": ["HDMI-A-1"],
      "8": ["HDMI-A-1"]
    },
    "format-icons": {
      "1": "⠸ SYS",
      "2": "⊞ DEV",
      "3": "⠯ WEB",
      "4": "⠵ MEDIA",
      "5": "⬝ COMMS",
      "6": "⬝ NOTES",
      "7": "⬝ INFRA",
      "8": "⬝ GAMES",
      "9": "⬝ SCRATCH",
      "1:SYS": "⠸ SYS",
      "2:DEV": "⊞ DEV",
      "3:WEB": "⠯ WEB",
      "4:MEDIA": "⠵ MEDIA",
      "5:COMMS": "⬝ COMMS",
      "6:NOTES": "⬝ NOTES",
      "7:INFRA": "⬝ INFRA",
      "8:GAMES": "⬝ GAMES",
      "1:web": "⠸ SYS",
      "2:code": "⊞ DEV",
      "3:term": "⠯ WEB",
      "4:containers": "⠵ MEDIA",
      "8:games": "⬝ GAMES",
      "default": "⬝",
      "urgent": "⊞"
    },
    "tooltip": true,
    "tooltip-format": "Workspace {name} [{icon}]",
    "smooth-scrolling-threshold": 1,
    "disable-scroll-wraparound": false,
    "enable-bar-scroll": false,
    "disable-markup": false,
    "current-only": false,
  },
  // waybar-tray
  "tray": {
    "icon-size": 16,
    "spacing": 10,
  },
  // waybar-swaync notification control
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
