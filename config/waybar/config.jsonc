// ~/.config/waybar/config.jsonc
// Production Waybar layout — Monolith TUI header bar with 1px solid bottom border.
[
  {
    "output": "HDMI-A-1",
    "include": "~/.config/waybar/modules.jsonc",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": ["custom/polyomino", "sway/workspaces", "custom/media"],
    "modules-center": ["sway/window"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "cpu", "memory", "battery", "tray", "custom/notification", "clock"],
    "clock": {
      "interval": 1,
      "align": 0,
      "rotate": 0,
      "tooltip": true,
      "format": " {:%H:%M}",
      "tooltip-format": "{:%H:%M:%S  ·  %A %d %B %Y}",
      "on-click": "~/.local/bin/polyomino calendar --output HDMI-A-1",
    },
    "custom/polyomino": {
      "format": "⊞",
      "tooltip": false,
      "on-click": "~/.local/bin/polyomino menu --output HDMI-A-1",
      "on-click-right": "kitty --class=polyomino-power -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino power-menu",
    },
  },
  {
    "output": "eDP-1",
    "include": "~/.config/waybar/modules.jsonc",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": ["custom/polyomino", "sway/workspaces", "custom/media"],
    "modules-center": ["sway/window"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "cpu", "memory", "battery", "tray", "custom/notification", "clock"],
    "clock": {
      "interval": 1,
      "align": 0,
      "rotate": 0,
      "tooltip": true,
      "format": " {:%H:%M}",
      "tooltip-format": "{:%H:%M:%S  ·  %A %d %B %Y}",
      "on-click": "~/.local/bin/polyomino calendar --output eDP-1",
    },
    "custom/polyomino": {
      "format": "⊞",
      "tooltip": false,
      "on-click": "~/.local/bin/polyomino menu --output eDP-1",
      "on-click-right": "kitty --class=polyomino-power -o initial_window_width=80c -o initial_window_height=36c -o font_size=12 -e ~/.local/bin/polyomino power-menu",
    },
  },
]
