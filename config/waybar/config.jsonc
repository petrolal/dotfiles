{
  "layer": "top",
  "position": "bottom",
  "height": 30,
  "spacing": 2,
  "modules-left": [
    "custom/start",
    "wlr/taskbar",
    "hyprland/workspaces",
    "sway/workspaces"
  ],
  "modules-center": [
    "hyprland/window",
    "sway/window"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "battery",
    "clock"
  ],
  "custom/start": {
    "format": "🪟 Start",
    "on-click": "wofi --show drun",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.20}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },
  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇 Muted",
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "🛜 {essid}",
    "format-ethernet": "🖧 LAN",
    "format-disconnected": "⚠️ Offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "battery": {
    "format": "🔋 {capacity}%",
    "format-charging": "⚡ {capacity}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 4
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  }
}
