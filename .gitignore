# ==============================================================================
# Dotfiles Repository .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Artifacts & Binaries
# ------------------------------------------------------------------------------
# Gradle output
build/
.gradle/
*.class

# GraalVM Native Image & Eclipse output directory
bin/

# Compiled C shared libraries & object files
config/gtk-3.0/libwrapper-menu-fix.so
*.so
*.o
*.a

# ------------------------------------------------------------------------------
# Nix & Environment Tools
# ------------------------------------------------------------------------------
# Nix build symlinks
result
result-*

# Direnv cache
.direnv/
.envrc.cache

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# Eclipse
.classpath
.project
.settings/
.factorypath

# IntelliJ IDEA
# Ignoring the directory itself (.idea/) rather than its contents (.idea/*)
# would make the negation below a no-op -- git never re-includes a file
# whose parent directory is excluded.
.idea/*
# ...except the Gradle JVM pin: this project's own Gradle sync fails against
# a stale/incompatible cached JDK selection (see .idea/gradle.xml) without
# it, so it's tracked rather than left as per-machine, re-discovered-by-hand
# IDE state like the rest of .idea/.
!.idea/gradle.xml
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/

# NetBeans
nbproject/private/

# ------------------------------------------------------------------------------
# Editor Backups & Swap Files
# ------------------------------------------------------------------------------
*~
*.swp
*.swo
*.swn
*.bak
*.orig
*.rej
.#*
\#*#

# ------------------------------------------------------------------------------
# Logs & JVM Crash Dumps
# ------------------------------------------------------------------------------
*.log
hs_err_pid*.log
replay_pid*.log

# ------------------------------------------------------------------------------
# OS & Desktop Cache Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.cache
.icon-theme.cache
icon-theme.cache
